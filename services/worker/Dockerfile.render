FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 PIP_DEFAULT_TIMEOUT=100 NUMBA_CACHE_DIR=/tmp/numba_cache
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY libs/common /libs/common
RUN --mount=type=cache,target=/root/.cache/pip pip install "/libs/common[storage]"
COPY services/worker/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY services/worker/app ./app
RUN useradd -r app && chown -R app /srv
USER app
# HTTP-triggered mode (app.http:app, POST /tick) instead of the persistent app.main loop -
# see app/http.py for why. Render injects its own $PORT at runtime; shell form so it expands.
CMD uvicorn app.http:app --host 0.0.0.0 --port ${PORT:-8000}

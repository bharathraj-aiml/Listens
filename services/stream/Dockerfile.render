FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY libs/common /libs/common
RUN pip install "/libs/common[web,storage]"
COPY services/stream/requirements.txt .
RUN pip install -r requirements.txt
COPY services/stream/app ./app
RUN useradd -r app && chown -R app /srv
USER app
# Render injects its own $PORT at runtime (not a fixed 8000 like docker-compose) - shell form
# so the variable actually expands; falls back to 8000 if unset, same as local.
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}

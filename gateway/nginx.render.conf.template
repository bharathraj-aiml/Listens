# Render variant of nginx.conf: locally, docker-compose gives every service a fixed name
# ("auth", "catalogue", ...) on one Docker network; on Render's free tier there's no private
# networking between services (confirmed - the "Connect" panel only shows outbound IPs, no
# internal address), so each upstream here is the OTHER service's real public
# https://*.onrender.com URL instead, filled in at container start (envsubst, see
# Dockerfile.render) from env vars set on this gateway service.
#
# Two things proxying to a public https:// upstream needs that a same-network http:// upstream
# wouldn't:
#   - proxy_ssl_server_name on: sends SNI on the outbound TLS handshake. Render's edge is
#     multi-tenant (many services share IPs, routed by hostname via SNI/Host) - without this,
#     nginx's upstream TLS client doesn't indicate which hostname it wants, and Render has
#     nothing to route on.
#   - Host header set to $proxy_host (the upstream's own host:port, auto-derived by nginx from
#     whatever $up resolves to) instead of $host (the gateway's OWN incoming Host) - Render's
#     edge also routes on the Host header, so forwarding the gateway's own hostname here would
#     point it at the wrong service.
#
# Upstreams are referenced through "set $up ...; proxy_pass $up;" rather than a plain
# "proxy_pass https://host;" - a static proxy_pass resolves its hostname once, at nginx
# startup, and refuses to start at all if that name isn't resolvable yet ("host not found in
# upstream"), which is exactly what happened here when this service's container started before
# its sibling services existed. The $up indirection forces nginx to resolve lazily, per-request,
# via the resolver below (its IP is read from this container's own /etc/resolv.conf at startup -
# see Dockerfile.render - since Render's internal resolver address isn't published to hardcode).
worker_processes auto;
events { worker_connections 1024; }

http {
  resolver ${RESOLVER_IP} valid=10s;

  log_format main '$remote_addr "$request" $status $body_bytes_sent ${request_time}s';
  access_log /dev/stdout main;
  error_log  /dev/stderr warn;

  server_tokens off;
  client_max_body_size 1m;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen ${PORT};

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Render's free tier sleeps an idle service after ~15 min; the first request after that
    # wakes it, observed taking up to ~30s in testing. nginx's 60s default *should* cover that,
    # but give real margin - a 502 here means a real user's first request of the session fails
    # for no reason other than bad luck on timing, not an actual problem with the request.
    proxy_connect_timeout 90s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;

    location = /healthz { return 200 "ok\n"; }

    location /api/auth/ {
      set $up ${AUTH_UPSTREAM};
      rewrite ^/api/auth/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location = /api/catalogue/upload {
      set $up ${CATALOGUE_UPSTREAM};
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      client_max_body_size 600m;
      proxy_request_buffering off;
      proxy_read_timeout 900s;
      proxy_send_timeout 900s;
      proxy_pass $up;
    }

    location /api/catalogue/ {
      set $up ${CATALOGUE_UPSTREAM};
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location /api/stream/ {
      set $up ${STREAM_UPSTREAM};
      rewrite ^/api/stream/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location / {
      set $up ${FRONTEND_UPSTREAM};
      proxy_pass $up;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}

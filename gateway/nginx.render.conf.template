# Render variant of nginx.conf: locally, docker-compose gives every service a fixed name
# ("auth", "catalogue", ...) on one Docker network; on Render each service is deployed
# separately and only reachable at whatever internal address Render assigns it, so those
# addresses are filled in at container start (envsubst, see Dockerfile.render) from env vars
# you set on this gateway service once the other services are deployed and you can see their
# internal addresses in the Render dashboard. NEEDS VERIFICATION the first time you deploy -
# Render's exact internal-hostname format isn't something that could be tested from outside
# a live account, so confirm the resulting $AUTH_UPSTREAM etc. actually resolve.
worker_processes auto;
events { worker_connections 1024; }

http {
  log_format main '$remote_addr "$request" $status $body_bytes_sent ${request_time}s';
  access_log /dev/stdout main;
  error_log  /dev/stderr warn;

  server_tokens off;
  client_max_body_size 1m;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen ${PORT};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /healthz { return 200 "ok\n"; }

    location /api/auth/ {
      rewrite ^/api/auth/(.*)$ /$1 break;
      proxy_pass ${AUTH_UPSTREAM};
    }

    location = /api/catalogue/upload {
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      client_max_body_size 600m;
      proxy_request_buffering off;
      proxy_read_timeout 900s;
      proxy_send_timeout 900s;
      proxy_pass ${CATALOGUE_UPSTREAM};
    }

    location /api/catalogue/ {
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      proxy_pass ${CATALOGUE_UPSTREAM};
    }

    location /api/stream/ {
      rewrite ^/api/stream/(.*)$ /$1 break;
      proxy_pass ${STREAM_UPSTREAM};
    }

    location / {
      proxy_pass ${FRONTEND_UPSTREAM};
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}

# Render variant of nginx.conf: locally, docker-compose gives every service a fixed name
# ("auth", "catalogue", ...) on one Docker network; on Render each service is deployed
# separately and only reachable at whatever internal address Render assigns it, so those
# addresses are filled in at container start (envsubst, see Dockerfile.render) from env vars
# you set on this gateway service once the other services are deployed.
#
# Upstreams are referenced through "set $up ...; proxy_pass $up;" rather than a plain
# "proxy_pass http://host:port;" - a static proxy_pass resolves its hostname once, at nginx
# startup, and refuses to start at all if that name isn't resolvable yet ("host not found in
# upstream"), which is exactly what happens here if this service's container starts before
# its sibling services have internal addresses assigned. The $up indirection forces nginx to
# resolve lazily, per-request, via the resolver below (its IP is read from this container's
# own /etc/resolv.conf at startup - see Dockerfile.render - since Render's internal resolver
# address isn't published anywhere to hardcode).
worker_processes auto;
events { worker_connections 1024; }

http {
  resolver ${RESOLVER_IP} valid=10s;

  log_format main '$remote_addr "$request" $status $body_bytes_sent ${request_time}s';
  access_log /dev/stdout main;
  error_log  /dev/stderr warn;

  server_tokens off;
  client_max_body_size 1m;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen ${PORT};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /healthz { return 200 "ok\n"; }

    location /api/auth/ {
      set $up ${AUTH_UPSTREAM};
      rewrite ^/api/auth/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location = /api/catalogue/upload {
      set $up ${CATALOGUE_UPSTREAM};
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      client_max_body_size 600m;
      proxy_request_buffering off;
      proxy_read_timeout 900s;
      proxy_send_timeout 900s;
      proxy_pass $up;
    }

    location /api/catalogue/ {
      set $up ${CATALOGUE_UPSTREAM};
      rewrite ^/api/catalogue/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location /api/stream/ {
      set $up ${STREAM_UPSTREAM};
      rewrite ^/api/stream/(.*)$ /$1 break;
      proxy_pass $up;
    }

    location / {
      set $up ${FRONTEND_UPSTREAM};
      proxy_pass $up;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}

# Copy to .env and change secrets before sharing this anywhere public.
POSTGRES_USER=listens
POSTGRES_PASSWORD=listens_dev_password
POSTGRES_DB=listens

# Used by every Python service. Host "postgres"/"redis" are compose service names.
DATABASE_URL=postgresql+psycopg2://listens:listens_dev_password@postgres:5432/listens
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

MINIO_ROOT_USER=listens_minio
MINIO_ROOT_PASSWORD=listens_minio_password
S3_BUCKET_AUDIO=listens-audio
S3_BUCKET_COVERS=listens-covers

GATEWAY_PORT=8080

# Copy to .env and change secrets before sharing this anywhere public.
POSTGRES_USER=listens
POSTGRES_PASSWORD=listens_dev_password
POSTGRES_DB=listens

# Used by every Python service. Host "postgres"/"redis" are compose service names.
DATABASE_URL=postgresql+psycopg2://listens:listens_dev_password@postgres:5432/listens
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Object storage: Backblaze B2 (S3-compatible API). Create a private bucket for audio and one
# for covers in the B2 console, then an Application Key scoped to your account (Read and Write),
# and fill in the real values below - the app will not start with these example placeholders.
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_ACCESS_KEY=your-b2-application-key-id
S3_SECRET_KEY=your-b2-application-key
S3_BUCKET_AUDIO=your-audio-bucket-name
S3_BUCKET_COVERS=your-covers-bucket-name

# Signs streaming/cover URLs. Generate a different value from JWT_SECRET.
STREAM_SIGNING_SECRET=dev-only-stream-secret-dev-only-stream-secret
MAX_UPLOAD_MB=500
# aac (default) plays in every browser; mp3 only for browser builds that lack AAC.
HLS_AUDIO_CODEC=aac

# How often services/recommender retrains the ALS recommendation model.
RECOMMENDER_TRAIN_INTERVAL_HOURS=24

GATEWAY_PORT=8080
